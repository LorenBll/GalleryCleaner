# GalleryCleaner configuration overrides.
# Copy this file to .env and fill in your values.

# Path to the directory, expressed as a DiskIdentifier ultimate absolute path.
# Format: <64-char-disk-identifier-hex-hash>::<relative-path-within-disk>
# Example: bf5de32849cf52543eddf648d3cda6a3be93114eee9e1004d9174b6e606f9f80::Pictures/Screenshots
# OBSIDIAN_VAULT_PATH=
